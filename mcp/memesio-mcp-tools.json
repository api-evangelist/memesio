      {
        "name": "search_templates",
        "title": "Search templates",
        "description": "Search the public meme template library before committing to a format. Use mediaType=gif or mediaType=all before calling generate_gif.",
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "q": {
              "type": "string",
              "maxLength": 200,
              "description": "Search query for meme templates."
