      {
        "name": "generate_meme",
        "title": "Generate meme",
        "description": "Select an existing meme template, generate captions, and return one or more meme variants.",
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "apiKey": {
              "type": "string",
              "minLength": 1,
              "description": "Agent or developer API key for AI meme generation."
