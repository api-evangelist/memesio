            "captions": {
              "minItems": 1,
              "maxItems": 8,
              "type": "array",
              "items": {},
              "description": "Caption slot payloads or plain strings, ordered to match the template."
            },
            "visibility": {
              "type": "string",
              "enum": [
                "private",
                "public"
              ],
              "description": "Whether the created meme should be publicly shareable."
            },
