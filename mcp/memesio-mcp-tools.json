      {
        "name": "caption_template",
        "title": "Caption template",
        "description": "Render a hosted meme from a known template slug and caption slots. Watermark customization is applied only for premium callers.",
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
