            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/ai/memes/generate",
            "auth": {
              "type": "apikey",
              "key": "x-developer-api-key",
              "value": "{{x-developer-api-key}}",
              "placement": "header"
            }
          },
